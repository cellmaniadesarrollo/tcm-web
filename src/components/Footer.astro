---
import TcmLogo from "../components/Icons/TcmLogo.astro"
import { STOREPAGE_URL } from "../config"
---

<style>
  .footer-bg {
    background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%);
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }
  .nav-link {
    position: relative;
    transition: all 0.3s ease;
    color: #1e40af;
  }
  .nav-link:hover {
    color: #1e3a8a;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: #1e40af;
    transition: width 0.3s ease;
  }
  .nav-link:hover::after {
    width: 100%;
  }
  .social-icon {
    transition: all 0.3s ease;
    fill: #4b5563;
  }
  .social-icon:hover {
    transform: translateY(-3px);
    fill: #1e40af;
  }
  .legal-link {
    transition: all 0.2s ease;
    color: #6b7280;
  }
  .legal-link:hover {
    color: #1f2937;
  }
</style>

<footer class="footer-bg py-16 md:py-24">
  <div class="container mx-auto px-4 max-w-6xl">
   <!-- Logo usando la Opción 2 -->
    <a href="/" class="mb-10 transition-transform duration-300 hover:scale-105 inline-block">
      <div class="w-64 h-auto">
        <TcmLogo />
      </div>
    </a>
      
      <nav class="flex flex-wrap justify-center gap-6 md:gap-10 mb-12">
        <a href="/sucursales" class="nav-link font-medium text-lg">
          Sucursales
        </a>
        <a href="/contenido/articulos" class="nav-link font-medium text-lg">
          Artículos
        </a>
        <a href="/contenido/videos" class="nav-link font-medium text-lg">
          Videos
        </a>
        <a href={STOREPAGE_URL} target="_blank" class="nav-link font-medium text-lg">
          Tienda
        </a>
        <a 
          href="https://api.whatsapp.com/send/?phone=593963644323&text&type=phone_number&app_absent=0" 
          target="_blank" 
          class="nav-link font-medium text-lg"
        >
          Contáctanos
        </a>
      </nav>
      
      <!-- Redes sociales -->
