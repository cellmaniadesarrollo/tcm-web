---
import { Image } from "astro:assets";
---

<style>
  .service-card {
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }
  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.15);
  }
  .gradient-bg {
    background: linear-gradient(135deg, #0c4a6e 0%, #0369a1 100%);
  }
  .btn-service {
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .btn-service::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: all 0.6s ease;
  }
  .btn-service:hover::after {
    left: 100%;
  }
  .title-decoration::after {
    content: '';
    display: block;
    width: 60px;
    height: 3px;
    background: #38bdf8;
    margin: 12px auto;
  }
</style>

<section class="py-16 md:py-24 bg-gray-50">
  <div class="container mx-auto px-4 max-w-6xl">
    <!-- Encabezado -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-sky-900 mb-6">
        <span class="title-decoration inline-block">Brindamos servicios profesionales</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Soluciones técnicas de calidad con garantía y repuestos originales
      </p>
    </div>

    <!-- Tarjetas de servicios -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Tarjeta de repuestos -->
      <div class="service-card bg-white rounded-xl overflow-hidden">
        <div class="p-8">
          <header class="mb-6">
            <span class="inline-block px-4 py-1 bg-sky-100 text-sky-800 rounded-full text-sm font-medium">
              Repuestos originales
            </span>
          </header>
          <div class="flex justify-center mb-6">
            <Image
              class="object-contain aspect-square w-64 h-64 transition duration-500 hover:scale-105"
              src='/images/services/celular.webp'
              width={256}
              height={256}
              alt="Repuestos para celulares"
              loading={'lazy'}
            />
          </div>
          <h4 class="text-2xl font-bold text-gray-800 text-center mb-4">
            Componentes de calidad para tus dispositivos
          </h4>
          <p class="text-gray-600 text-center mb-6">
            Disponemos de los mejores repuestos del mercado con garantía de calidad
          </p>
          <div class="text-center">
            <a
              href="#contacto"
              class="btn-service inline-block px-6 py-3 bg-sky-600 text-white rounded-lg font-medium hover:bg-sky-700"
            >
              Consultar disponibilidad
            </a>
          </div>
        </div>
      </div>

      <!-- Columna derecha (dos tarjetas) -->
      <div class="grid grid-cols-1 gap-8">
        <!-- Servicio técnico consolas -->
        <div class="service-card bg-gradient-to-br from-sky-100 to-sky-50 rounded-xl overflow-hidden">
          <div class="p-8">
            <header class="mb-6">
              <span class="inline-block px-4 py-1 bg-white text-sky-800 rounded-full text-sm font-medium">
                Servicio técnico
              </span>
            </header>
            <div class="relative flex justify-center mb-6">
              <Image
                class="object-contain aspect-square w-64 h-64 transition duration-500 hover:scale-105"
                src='/images/services/playstation.webp'
                width={256}
                height={256}
                alt="Reparación de consolas"
                loading={'eager'}
              />
            </div>
            <h4 class="text-2xl font-bold text-gray-800 text-center mb-4">
              Mantenimiento y reparación de consolas
            </h4>
            <div class="text-center mt-6">
              <a
                target="_blank"
                rel="noopener noreferrer"
                href="https://orders.teamcellmania.com/check-order"
                class="btn-service inline-flex items-center px-6 py-3 bg-gray-900 text-white rounded-lg font-medium hover:bg-gray-800"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                Consultar estado de tu equipo
              </a>
            </div>
          </div>
        </div>

        <!-- Servicio técnico computadoras -->
        <div class="service-card bg-gradient-to-br from-sky-200 to-sky-100 rounded-xl overflow-hidden">
          <div class="p-8">
            <header class="mb-6">
              <span class="inline-block px-4 py-1 bg-white text-sky-800 rounded-full text-sm font-medium">
                Servicio técnico
              </span>
            </header>
            <div class="relative flex justify-center mb-6">
              <Image
                class="object-contain aspect-square w-64 h-64 transition duration-500 hover:scale-105"
                src='/images/services/computadora.webp'
                width={256}
                height={256}
                alt="Reparación de computadoras"
                loading={'eager'}
              />
            </div>
            <h4 class="text-2xl font-bold text-gray-800 text-center mb-4">
              Reparación profesional de computadoras
            </h4>
            <div class="text-center mt-6">
              <a
                target="_blank"
                rel="noopener noreferrer"
                href="https://orders.teamcellmania.com/check-order"
                class="btn-service inline-flex items-center px-6 py-3 bg-gray-900 text-white rounded-lg font-medium hover:bg-gray-800"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                Consultar estado de tu equipo
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>