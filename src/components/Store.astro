---
import { Image } from "astro:assets";
import type { Product } from "../types";
import CardProducts from "./CardProducts.astro";
import { POST } from "../pages/products.json";
import { STOREPAGE_URL } from "../config";

let products = await POST();
const productsResult = await products?.json(); 
---

<style>
  .gradient-bg {
    background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
  }
  .product-card {
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    background: white;
  }
  .product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(30, 58, 138, 0.15);
  }
  .btn-hover-effect {
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .btn-hover-effect::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    transition: all 0.6s ease;
    z-index: -1;
  }
  .btn-hover-effect:hover::before {
    left: 100%;
  }
  .section-title {
    position: relative;
    display: inline-block;
  }
  .section-title::after {
    content: '';
    position: absolute;
    bottom: -12px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 4px;
    background: linear-gradient(90deg, #3b82f6, #10b981);
    border-radius: 2px;
  }
  .fade-up {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .price-tag {
    background: linear-gradient(135deg, #3b82f6 0%, #10b981 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }
</style>

<!-- Hero Section -->
<section class="gradient-bg py-16 md:py-24 relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0 bg-gradient-to-r from-blue-900/30 to-blue-600/30"></div>
  </div>
  
  <div class="container mx-auto px-4 max-w-7xl relative z-10">
    <div class="flex flex-col lg:flex-row items-center">
      <div class="lg:w-1/2 mb-10 lg:mb-0 lg:pr-12">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl transform hover:scale-[1.02] transition duration-500">
          <Image 
            src="/images/teamcellmania.webp" 
            width={640} 
            height={640} 
            alt="Tienda de electrónicos"
            class="w-full h-auto object-cover"
            loading="eager"
            format="webp"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-blue-900/40 to-transparent"></div>
        </div>
      </div>
      
      <div class="lg:w-1/2 text-white">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
          Explora Nuestra <span class="text-blue-200">Tienda Digital</span>
        </h2>
        <p class="text-xl md:text-2xl mb-8 leading-relaxed opacity-90 max-w-lg">
          Descubre tecnología innovadora y soluciones electrónicas que transformarán tu experiencia digital.
        </p>
        
        <div style="--animation-delay: 0.6s" class="fade-up">
          <a 
            href={STOREPAGE_URL} 
            class="btn-hover-effect inline-flex items-center px-8 py-4 bg-black text-white rounded-xl font-bold text-lg hover:bg-gray-900 transition duration-300 shadow-lg"
          >
            <div class="mr-3">
              <svg viewBox="0 0 24 24" width="24" height="24" class="fill-none stroke-current">
                <g stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19.5 22a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM9.5 22a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" fill="#000"/>
                  <path d="M16.5 4H22l-2 11h-4.5m1-11-1 11m1-11h-5.75m4.75 11h-4m-.75-11H5l2 11h4.5m-.75-11 .75 11M5 4c-.167-.667-1-2-3-2M20 15H5.23c-1.784 0-2.73.781-2.73 2 0 1.219.946 2 2.73 2H19.5"/>
                </g>
              </svg>
            </div>
            <span>Explorar Catálogo</span>
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Products -->
<section class="py-20 bg-gray-50">
  <div class="container mx-auto px-4 max-w-7xl">
    <header class="text-center mb-16">
      <h2 class="section-title text-4xl font-bold text-gray-900 inline-block mb-4">
        Productos Destacados
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Los productos más populares y mejor valorados por nuestros clientes
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a 
        class="product-card group cursor-pointer text-center"
        href={`${STOREPAGE_URL}/products/traductor-timekettle-x1-interpreter-hub`}
        target="_blank"
      >
        <div class="p-6 pb-0">
          <div class="relative h-60 w-full flex items-center justify-center">
            <Image 
              alt="Traductor Timekettle" 
              loading="eager" 
              class="object-contain h-full w-full transition duration-500 group-hover:scale-110" 
              src="/images/products/traductor.webp" 
              width={240} 
              height={240} 
            />
          </div>
        </div>
        <div class="p-6 pt-4">
          <h4 class="font-bold text-lg text-gray-800 mb-2 group-hover:text-blue-600 transition">
            Traductor Timekettle X1
          </h4>
          <span class="price-tag font-bold text-2xl">$800.00</span>
          <div class="mt-4">
            <span class="badge bg-green-100 text-green-800">
              Nuevo
            </span>
          </div>
        </div>
      </a>

