<!-- New Arrivals -->
<section class="py-20 bg-white">
  <div class="container mx-auto px-4 max-w-7xl">
    <header class="text-center mb-16">
      <h2 class="section-title text-4xl font-bold text-gray-900 inline-block mb-4">
        Nuevos Productos
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Descubre nuestras últimas incorporaciones con tecnología de vanguardia
      </p>
    </header>

    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      {
        productsResult?.allProducts.edges.map((product: Product) => (
          <CardProducts product={product} />
        ))
      }
    </section>

    <div class="text-center mt-16">
      <a 
        href={STOREPAGE_URL} 
        class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-800 text-white font-bold rounded-xl hover:from-blue-700 hover:to-blue-900 transition duration-300 shadow-lg"
      >
        Ver todos los productos
        <svg class="ml-3 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
