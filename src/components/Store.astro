              class="object-contain h-full w-full transition duration-500 group-hover:scale-110" 
              src="/images/products/remont_macbookair_head.webp" 
              width={240} 
              height={240} 
            />
          </div>
        </div>
        <div class="p-6 pt-4">
          <h4 class="font-bold text-lg text-gray-800 mb-2 group-hover:text-blue-600 transition">
            MacBook Air 11.6"
          </h4>
          <span class="price-tag font-bold text-2xl">$260.00</span>
        </div>
      </a> -->

      <a 
        class="product-card group cursor-pointer text-center"
        href={`${STOREPAGE_URL}/products/molde-de-laminacion-de-oca-universal`}
        target="_blank"
      >
        <div class="p-6 pb-0">
          <div class="relative h-60 w-full flex items-center justify-center">
            <Image 
              alt="Molde de laminación" 
              loading="eager" 
              class="object-contain h-full w-full transition duration-500 group-hover:scale-110" 
              src="/images/products/1.webp" 
              width={240} 
              height={240} 
            />
          </div>
        </div>
        <div class="p-6 pt-4">
          <h4 class="font-bold text-lg text-gray-800 mb-2 group-hover:text-blue-600 transition">
            Molde OCA Universal
