---
export interface Props {
  articlesLength: number;
}

const { articlesLength } = Astro.props;
---

<style>
  .stat-card {
    transition: all 0.3s ease;
    background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    position: relative;
    overflow: hidden;
  }
  .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
  }
  .stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(to bottom, #3b82f6, #10b981);
  }
  .stat-number {
    background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat-icon {
    width: 40px;
    height: 40px;
    margin: 0 auto 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, #3b82f6 0%, #10b981 100%);
    color: white;
  }
</style>

<section class="py-12 md:py-16 bg-gray-50">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <!-- Tarjeta 1: Órdenes de servicio -->
      <div class="stat-card p-6 rounded-lg">
        <div class="stat-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <h5 class="text-center font-bold text-4xl mb-2 stat-number">10.000+</h5>
        <span class="text-center text-gray-600">Órdenes de servicio</span>
      </div>

      <!-- Tarjeta 2: TikToks -->
      <div class="stat-card p-6 rounded-lg">
        <div class="stat-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v3m18 0v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8m18 0h-6"></path>
          </svg>
        </div>
        <h5 class="text-center font-bold text-4xl mb-2 stat-number">277</h5>
        <span class="text-center text-gray-600">Videos en TikTok</span>
      </div>

      <!-- Tarjeta 3: Artículos -->
      <div class="stat-card p-6 rounded-lg">
        <div class="stat-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
        </div>
        <h5 class="text-center font-bold text-4xl mb-2 stat-number">{articlesLength}</h5>
        <span class="text-center text-gray-600">Artículos técnicos</span>
      </div>

      <!-- Tarjeta 4: Videos YouTube -->
      <div class="stat-card p-6 rounded-lg">
        <div class="stat-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
            <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
          </svg>
        </div>
        <h5 class="text-center font-bold text-4xl mb-2 stat-number">185</h5>
        <span class="text-center text-gray-600">Videos en YouTube</span>
      </div>
    </div>
  </div>
</section>