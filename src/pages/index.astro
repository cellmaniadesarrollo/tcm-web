---
// src/pages/index.astro
import Header from "../components/Header.astro";
import Body from "../components/Body.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import getSortedPosts from "../utils/getSortedPosts";
import Card from "../components/Card.astro";
import { getCollection } from "astro:content";
import getSortedVideos from "../utils/getSortedVideos";
import type { VideoYoutube } from "../types";
import CardVideos from "../components/CardVideos.astro";
import Button from "../components/Button.astro";
import ArticleIcon from "../components/Icons/ArticleIcon.astro";
import VideoIcon from "../components/Icons/VideoIcon.astro";
import Masthead from "../components/Masthead.astro";
import { GET } from "./videos.json";
import Services from "../components/Services.astro";
import Store from "../components/Store.astro";
import Summary from "../components/Summary.astro";
import Slider from "../components/Slider";

let videos = await GET(Astro);
const result = await videos.json();
const sortedVideos = getSortedVideos(result);
const posts = await getCollection("blog");
const sortedPosts = await getSortedPosts(posts);

// Configuración del sitio - mejorada para SEO local
const siteTitle = "Reparación de Celulares en Azogues y Biblián | TeamCellMania - iPhone, Android, Pantallas, Baterías";
const siteDescription = "Reparación rápida y confiable de iPhone, Samsung, Xiaomi y más en Azogues y Biblián. Cambiamos pantallas, baterías, glass y back cover con piezas originales. Venta de celulares y accesorios. ¡Cotiza gratis ahora! +593 96 364 4323";
const siteUrl = "https://www.teamcellmania.com";
const siteKeywords = "reparación celulares Azogues, reparación iPhone Azogues, cambio batería Android Biblián, venta celulares Ecuador, accesorios celulares Cañar";
const contactPhone = "+593 96 364 4323";
const contactEmail = "teamcellmania@gmail.com";
const address = {
  "@type": "PostalAddress",
  "streetAddress": "Luis Cordero Crespo 4-17 y Sucre",
  "addressLocality": "Azogues",
  "addressRegion": "Cañar",
  "postalCode": "030102",
  "addressCountry": "EC"
};
---

<style>
  :root {
    --primary: #1e40af;
    --primary-light: #3b82f6;
    --secondary: #10b981;
    --dark: #1f2937;
    --light: #f9fafb;
  }
  
  .section-padding {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  
  @media (min-width: 768px) {
    .section-padding {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }
  
  .gradient-text {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  
  .card-hover {
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }
  
  .card-hover:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
  }
  
  .btn-hover {
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .btn-hover::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: all 0.6s ease;
  }
  
  .btn-hover:hover::after {
    left: 100%;
  }
  
  .section-title {
    position: relative;
    display: inline-block;
  }
  
  .section-title::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 3px;
    background: var(--primary-light);
  }
  
  .fade-up {
    animation: fadeInUp 0.8s ease forwards;
    opacity: 0;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #contenedor-cotiza {
    transition: all 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateY(-50%) translateX(0);
    box-shadow: -8px 0 40px -8px rgba(79, 70, 229, 0.18), -2px 0 0 0 rgba(79,70,229,0.12);
    border-radius: 20px 0 0 20px;
    overflow: hidden;
  }

  #contenedor-cotiza.es-minimizado {
    transform: translateY(-50%) translateX(calc(100% - 48px));
  }

  @media (max-width: 768px) {
    #contenedor-cotiza.es-minimizado {
      transform: translateY(-50%) translateX(calc(100% - 42px));
    }
  }
</style>

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Título y descripción optimizados para SEO local -->
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="keywords" content={siteKeywords} />
    <meta name="author" content="TeamCellMania" />
    <meta name="robots" content="index, follow" />

    <!-- Meta tags locales / geo (muy útiles para búsquedas en Ecuador) -->
    <meta name="geo.region" content="EC-C" />
    <meta name="geo.placename" content="Azogues" />
    <meta name="geo.position" content="-2.73982;-78.84561" />
    <meta name="ICBM" content="-2.73982, -78.84561" />

    <!-- Open Graph y Twitter mejorados -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/social-preview.jpg" />
    <meta property="og:locale" content="es_EC" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content="/images/social-preview.jpg" />

    <!-- Favicons modernos 2025–2026 (prioridad SVG) -->
<link rel="icon" href="/favicon.ico?v=2" sizes="any" />
<link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
<link rel="manifest" href="/site.webmanifest?v=2" />
<meta name="theme-color" content="#1e40af" />
    <!-- Opcional: Safari mask icon -->
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#1e40af" />

    <!-- Schema.org mejorado -->
    <script type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Store",
      "name": "TeamCellMania",
      "url": siteUrl,
      "logo": "/images/logo.jpg",
      "description": siteDescription,
      "telephone": contactPhone,
      "email": contactEmail,
      "address": address,
      "priceRange": "$$",
      "paymentAccepted": "Efectivo, Transferencia bancaria, Tarjetas de crédito/débito",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "08:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Sunday",
          "opens": "09:00",
          "closes": "13:00"
        }
      ],
      "additionalType": "https://schema.org/CellPhoneStore",
      "areaServed": {
        "@type": "Place",
        "name": "Azogues y Biblián",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Azogues",
          "addressRegion": "Cañar",
          "addressCountry": "EC"
        }
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -2.73982,
        "longitude": -78.84561
      },
      "sameAs": [
        "https://www.facebook.com/teamcellmania",
        "https://www.instagram.com/teamcellmania",
        "https://twitter.com/teamcellmania"
      ]
    })}
    </script>

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4823314192086788" crossorigin="anonymous"></script>

    <!-- Google Adsense (mantengo el tuyo) -->
    <meta name="google-adsense-account" content="ca-pub-8627688040171449">
  </head>

  <Body class="bg-gray-50">
    <Header />
    
    <main class="pt-[76px]">
      <!-- Hero Slider -->
      <section class="bg-gradient-to-r from-blue-900 to-blue-700 py-8 md:py-12">
        <div class="mx-auto max-w-7xl px-4">
          <Slider client:load />
        </div>
      </section>

      <!-- Resumen de servicios -->
      <Summary articlesLength={sortedPosts.length} />

      <!-- Nuestros servicios -->
      <Services />

      <!-- Sección de artículos -->
      <section class="section-padding bg-white">
        <div class="mx-auto max-w-7xl px-4">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <div class="lg:sticky lg:top-[100px] h-fit">
              <header class="mb-8">
                <h2 class="section-title text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                  Artículos Técnicos
                </h2>
                <p class="text-xl text-gray-600">
                  ¡Conoce más y mantén tus dispositivos en perfecto estado!
                </p>
              </header>
              
              <div class="hidden lg:block">
                <a 
                  href="/contenido/articulos" 
                  class="btn-hover inline-flex items-center px-6 py-3 bg-blue-900 text-white rounded-lg font-medium hover:bg-blue-800 transition"
                >
                  <div class="w-6 fill-white mr-2">
                    <ArticleIcon />
                  </div>
                  <span>Ver todos los artículos</span>
                </a>
              </div>
            </div>

            <section class="grid grid-cols-1">
              <section class="group">
                {sortedPosts.map((data, index) => index < 3 && (
                  <Card href={`/contenido/articulos/${data.slug}`} frontmatter={data.data} loading="lazy" className="mx-6"/>
                ))}
              </section>
              <div style="--animation-delay: 0.6s" class="items-center fade-up inline-flex justify-end flex-wrap gap-4 mb-6">
                <Button href={"/contenido/articulos"} className="bg-blue-900 items-center">
                  <div class="w-6 fill-zinc-300">
                    <ArticleIcon />
                  </div>
                  <span>Ver más artículos</span>
                </Button>
              </div>
            </section>
          </div>
        </div>
      </section>

      <!-- Tienda -->
      <Store />

      <!-- Testimonios -->
      <Masthead />

      <!-- Sección de videos -->
      <section class="section-padding bg-gray-50">
        <div class="mx-auto max-w-7xl px-4">
          <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8">
            <h2 class="section-title text-3xl font-bold text-gray-900 mb-4 md:mb-0">
              Videos Tutoriales
            </h2>
            <a 
              href="/contenido/videos" 
              class="btn-hover inline-flex items-center px-6 py-3 bg-blue-900 text-white rounded-lg font-medium hover:bg-blue-800 transition"
            >
              <div class="w-6 stroke-white fill-none mr-2">
                <VideoIcon />
              </div>
              <span>Ver todos los videos</span>
            </a>
          </header>

          <section class="grid grid-cols-2 md:grid-cols-4 gap-4 group">
            {sortedVideos.map((video: VideoYoutube, index: number) => index < 4 && (
              <CardVideos data={video} loading="lazy"/>
            ))}
          </section>
        </div>
      </section>

      <!-- Flotante cotización (sin cambios, ya está bien) -->
      <div id="contenedor-cotiza" class="fixed right-0 top-1/2 -translate-y-1/2 z-50 flex items-center">
        <!-- ... (todo el bloque del flotante se mantiene igual) ... -->
      </div>

      <Footer />
    </main>

    <script>
      const contenedor = document.getElementById('contenedor-cotiza');
      let temporizadorCierre: number | undefined;

      function gestionarEstado(minimizar: boolean) {
        if (!contenedor) return;
        if (minimizar) {
          contenedor.classList.add('es-minimizado');
        } else {
          contenedor.classList.remove('es-minimizado');
          clearTimeout(temporizadorCierre);
        }
      }

      contenedor?.addEventListener('mouseenter', () => gestionarEstado(false));
      contenedor?.addEventListener('mouseleave', () => {
        temporizadorCierre = window.setTimeout(() => gestionarEstado(true), 1500);
      });

      document.getElementById('pestana-click')?.addEventListener('click', () => {
        if (contenedor?.classList.contains('es-minimizado')) {
          gestionarEstado(false);
        } else {
          gestionarEstado(true);
        }
      });

      document.getElementById('btn-cerrar')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        gestionarEstado(true);
      });

      window.addEventListener('load', () => {
        if (!contenedor) return;
        gestionarEstado(false);
        temporizadorCierre = window.setTimeout(() => {
          if (!contenedor.matches(':hover')) gestionarEstado(true);
        }, 10000);
      });
    </script>
  </Body>
</html>