---
//src\pages\index.astro
import Header from "../components/Header.astro";
import Body from "../components/Body.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import getSortedPosts from "../utils/getSortedPosts";
import Card from "../components/Card.astro";
import { getCollection } from "astro:content";
import getSortedVideos from "../utils/getSortedVideos";
import type { VideoYoutube } from "../types";
import CardVideos from "../components/CardVideos.astro";
import Button from "../components/Button.astro";
import ArticleIcon from "../components/Icons/ArticleIcon.astro";
import VideoIcon from "../components/Icons/VideoIcon.astro";
import Masthead from "../components/Masthead.astro";
import { GET } from "./videos.json";
const posts = await getCollection("blog");
import Services from "../components/Services.astro";
import Store from "../components/Store.astro";
import Summary from "../components/Summary.astro";
import Slider from "../components/Slider";

let videos = await GET(Astro);
const result = await videos.json();
const sortedVideos = getSortedVideos(result);
const sortedPosts = await getSortedPosts(posts);
 
// Configuración del sitio
const siteTitle = "TeamCellMania - Reparación y Venta de Celulares en Azogues y Biblián";
const siteDescription = "Expertos en reparación de celulares, iPhone, Android, Apple Watch, y otros dispositivos electrónicos. Venta de celulares, accesorios y servicios en Azogues y Biblián, Ecuador.";
const siteUrl = "https://www.teamcellmania.com";
const siteKeywords = "Reparación de celulares, venta de celulares, reparación iPhone, reparación Android, accesorios de celulares, Azogues, Biblián, Ecuador";
const contactPhone = "+593 96 364 4323";
const contactEmail = "teamcellmania@gmail.com";
const address = {
  "@type": "PostalAddress",
  "streetAddress": "Luis Cordero Crespo 4-17 y Sucre",
  "addressLocality": "Azogues",
  "addressRegion": "Cañar",
  "postalCode": "030102",
  "addressCountry": "Ecuador"
};
---

<style>
  :root {
    --primary: #1e40af;
    --primary-light: #3b82f6;
    --secondary: #10b981;
    --dark: #1f2937;
    --light: #f9fafb;
  }
  
  .section-padding {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  
  @media (min-width: 768px) {
    .section-padding {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }
  
  .gradient-text {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  
  .card-hover {
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }
  
  .card-hover:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
  }
  
  .btn-hover {
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .btn-hover::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: all 0.6s ease;
  }
  
  .btn-hover:hover::after {
    left: 100%;
  }
  
  .section-title {
    position: relative;
    display: inline-block;
  }
  
  .section-title::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 3px;
    background: var(--primary-light);
  }
  
  .fade-up {
    animation: fadeInUp 0.8s ease forwards;
    opacity: 0;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


  

#contenedor-cotiza {
  transition: all 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  transform: translateY(-50%) translateX(0);
  box-shadow: -8px 0 40px -8px rgba(79, 70, 229, 0.18), -2px 0 0 0 rgba(79,70,229,0.12);
  border-radius: 20px 0 0 20px;
  overflow: hidden;
}

#contenedor-cotiza.es-minimizado {
  transform: translateY(-50%) translateX(calc(100% - 48px));
}

@media (max-width: 768px) {
  #contenedor-cotiza.es-minimizado {
    transform: translateY(-50%) translateX(calc(100% - 42px));
  }
}
</style>

<html lang="es" class="scroll-smooth">
  <head>
    <title>{siteTitle}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDescription} />
    <meta name="keywords" content={siteKeywords} />
    <meta name="author" content="TeamCellMania" />
    <meta name="robots" content="index, follow" />
    <meta name="google-adsense-account" content="ca-pub-8627688040171449">

    <!-- Metaetiquetas para redes sociales -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/social-preview.jpg" />
    <meta property="og:locale" content="es_EC" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content="/images/social-preview.jpg" />

    <!-- Marcado de datos estructurados Schema.org -->
    <script type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Store",
      "name": "TeamCellMania",
      "url": siteUrl,
      "logo": "/images/logo.jpg",
      "description": siteDescription,
      "telephone": contactPhone,
      "email": contactEmail,
      "address": address,
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday"
          ],
          "opens": "08:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Sunday",
          "opens": "09:00",
          "closes": "13:00"
        }
      ],
      "additionalType": "https://schema.org/CellPhoneStore",
      "areaServed": {
        "@type": "Place",
        "name": "Azogues",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Azogues",
          "addressRegion": "Cañar",
          "addressCountry": "Ecuador"
        }
      },
      "sameAs": [
        "https://www.facebook.com/teamcellmania",
        "https://www.instagram.com/teamcellmania",
        "https://twitter.com/teamcellmania"
      ]
    })}
    </script>
    
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4823314192086788" crossorigin="anonymous"></script>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>

  <Body class="bg-gray-50">
    <Header />
    
    <main class="pt-[76px]">
      <!-- Hero Slider -->
      <section class="bg-gradient-to-r from-blue-900 to-blue-700 py-8 md:py-12">
        <div class="mx-auto max-w-7xl px-4">
          <Slider client:load />
        </div>
      </section>

      <!-- Resumen de servicios -->
      <Summary articlesLength={sortedPosts.length} />

      <!-- Nuestros servicios -->
      <Services />

      <!-- Sección de artículos -->
      <section class="section-padding bg-white">
        <div class="mx-auto max-w-7xl px-4">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <div class="lg:sticky lg:top-[100px] h-fit">
              <header class="mb-8">
                <h2 class="section-title text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                  Artículos Técnicos
                </h2>
                <p class="text-xl text-gray-600">
                  ¡Conoce más y mantén tus dispositivos en perfecto estado!
                </p>
              </header>
              
              <div class="hidden lg:block">
                <a 
                  href="/contenido/articulos" 
                  class="btn-hover inline-flex items-center px-6 py-3 bg-blue-900 text-white rounded-lg font-medium hover:bg-blue-800 transition"
                >
                  <div class="w-6 fill-white mr-2">
                    <ArticleIcon />
                  </div>
                  <span>Ver todos los artículos</span>
                </a>
              </div>
            </div>

            <section class="grid grid-cols-1">
              <section class="group">
                {sortedPosts.map((data, index) => index < 3 && (
                  <Card href={`/contenido/articulos/${data.slug}`} frontmatter={data.data} loading="lazy" className="mx-6"/>
                ))}
              </section>
              <div style="--animation-delay: 0.6s" class="items-center fade-up inline-flex justify-end flex-wrap gap-4 mb-6">
                <Button href={"/contenido/articulos"} className="bg-blue-900 items-center">
                  <div class="w-6 fill-zinc-300">
                    <ArticleIcon />
                  </div>
                  <span>Ver mas articulos</span>
                </Button>
              </div>
            </section>
          </div>
        </div>
      </section>

      <!-- Tienda -->
      <Store />

      <!-- Testimonios -->
      <Masthead />

      <!-- Sección de videos -->
      <section class="section-padding bg-gray-50">
        <div class="mx-auto max-w-7xl px-4">
          <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8">
            <h2 class="section-title text-3xl font-bold text-gray-900 mb-4 md:mb-0">
              Videos Tutoriales
            </h2>
            <a 
              href="/contenido/videos" 
              class="btn-hover inline-flex items-center px-6 py-3 bg-blue-900 text-white rounded-lg font-medium hover:bg-blue-800 transition"
            >
              <div class="w-6 stroke-white fill-none mr-2">
                <VideoIcon />
              </div>
              <span>Ver todos los videos</span>
            </a>
          </header>

        <section class="grid grid-cols-2 md:grid-cols-4 gap-4 group">
          {sortedVideos.map((video: VideoYoutube, index: number) => index < 4 && (
            <CardVideos data={video} loading="lazy"/>
          ))}
        </section>
        </div>
      </section>
<!-- Flotante cotización -->
<!-- Flotante cotización -->
<div id="contenedor-cotiza" class="fixed right-0 top-1/2 -translate-y-1/2 z-50 flex items-center">

  <!-- Pestaña lateral -->
  <button
    id="pestana-click"
    aria-label="Abrir cotizador"
    class="relative bg-black py-6 px-3 rounded-l-2xl flex flex-col items-center gap-3 cursor-pointer
           hover:bg-zinc-800 active:bg-zinc-900 transition-colors duration-200 border-none outline-none"
  >
    <svg class="w-5 h-5 text-white" viewBox="0 0 814 1000" fill="currentColor">
      <path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105-57.8-155.5-127.4C46 790.7 0 663 0 541.8c0-207.5 135.4-317.3 269-317.3 70.1 0 128.4 46.4 172.5 46.4 42.8 0 109.6-49 192.5-49 30.6 0 132.4 2.6 198.3 99zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/>
    </svg>
    <span class="[writing-mode:vertical-lr] text-white text-[10px] font-bold uppercase tracking-[0.18em] rotate-180 select-none">
      Cotizar
    </span>
  </button>

  <!-- Panel expandido -->
  <div class="bg-white border border-gray-200 rounded-l-none shadow-none" style="min-width: 300px; border-left: none;">

    <!-- Botón cerrar -->
    <div class="flex justify-end px-4 pt-3">
      <button
        id="btn-cerrar"
        aria-label="Cerrar"
        class="w-7 h-7 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center transition-colors text-gray-500 border-none cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="px-5 pb-5 flex flex-col gap-3">
      <!-- Título -->
      <div>
        <h3 class="text-[20px] font-extrabold text-gray-900 leading-tight tracking-tight">
          ¡Repara tu iPhone <span style="color: #007AFF;">HOY!</span>
        </h3>
        <!-- Chips -->
        <p class="mt-1.5 text-[12px] font-semibold tracking-wide" style="color: #007AFF;">
          Pantalla&nbsp;•&nbsp;Batería&nbsp;•&nbsp;Glass&nbsp;•&nbsp;Backcover
        </p>
      </div>

      <!-- Info -->
      <div class="flex flex-col gap-1 text-[13px] text-gray-600 leading-snug">
        <p>
          Piezas <strong style="color: #34C759;" class="font-bold">originales</strong> Apple&nbsp;·&nbsp;
           
        </p>
        <p class="text-gray-500">
          En <strong class="text-gray-700 font-semibold">Azogues</strong> y
          <strong class="text-gray-700 font-semibold">Biblián</strong>
          &nbsp;— Respuesta rápida
        </p>
      </div>

      <!-- CTA -->
      
       <a href="/repuestos"
        class="mt-1 flex items-center justify-between text-white font-bold text-[14px] rounded-xl px-5 py-3 transition-colors duration-200 no-underline"
        style="background: #34C759;"
        onmouseover="this.style.background='#2EBB50'" 
        onmouseout="this.style.background='#34C759'"
      >
        <span>¡Cotizar GRATIS ahora!</span>
        <svg class="w-4 h-4 ml-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</div>
      <Footer />
    </main>
<script>
  const contenedor = document.getElementById('contenedor-cotiza');
  let temporizadorCierre: number | undefined;

  function gestionarEstado(minimizar: boolean) {
    if (!contenedor) return;
    if (minimizar) {
      contenedor.classList.add('es-minimizado');
    } else {
      contenedor.classList.remove('es-minimizado');
      clearTimeout(temporizadorCierre);
    }
  }

  contenedor?.addEventListener('mouseenter', () => gestionarEstado(false));
  contenedor?.addEventListener('mouseleave', () => {
    temporizadorCierre = window.setTimeout(() => gestionarEstado(true), 1500);
  });

  document.getElementById('pestana-click')?.addEventListener('click', () => {
    if (contenedor?.classList.contains('es-minimizado')) {
      gestionarEstado(false);
    } else {
      gestionarEstado(true);
    }
  });

  document.getElementById('btn-cerrar')?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    gestionarEstado(true);
  });

  window.addEventListener('load', () => {
    if (!contenedor) return;
    gestionarEstado(false);
    temporizadorCierre = window.setTimeout(() => {
      if (!contenedor.matches(':hover')) gestionarEstado(true);
    }, 10000);
  });
</script>
  </Body>
</html>