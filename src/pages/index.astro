---
// src/pages/index.astro
import Header from "../components/Header.astro";
import Body from "../components/Body.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import getSortedPosts from "../utils/getSortedPosts";
import Card from "../components/Card.astro";
import { getCollection } from "astro:content";
import getSortedVideos from "../utils/getSortedVideos";
import type { VideoYoutube } from "../types";
import CardVideos from "../components/CardVideos.astro";
import Button from "../components/Button.astro";
import ArticleIcon from "../components/Icons/ArticleIcon.astro";
import VideoIcon from "../components/Icons/VideoIcon.astro";
import Masthead from "../components/Masthead.astro";
import { GET } from "./videos.json";
import Services from "../components/Services.astro";
import Store from "../components/Store.astro";
import Summary from "../components/Summary.astro";
import Slider from "../components/Slider";

let videos = await GET(Astro);
const result = await videos.json();
const sortedVideos = getSortedVideos(result);
const posts = await getCollection("blog");
const sortedPosts = await getSortedPosts(posts);

// Configuración del sitio - mejorada para SEO local
const siteTitle = "Reparación de Celulares en Azogues y Biblián | TeamCellMania - iPhone, Android, Pantallas, Baterías";
const siteDescription = "Reparación rápida y confiable de iPhone, Samsung, Xiaomi y más en Azogues y Biblián. Cambiamos pantallas, baterías, glass y back cover con piezas originales. Venta de celulares y accesorios. ¡Cotiza gratis ahora! +593 96 364 4323";
const siteUrl = "https://www.teamcellmania.com";
const siteKeywords = "reparación celulares Azogues, reparación iPhone Azogues, cambio batería Android Biblián, venta celulares Ecuador, accesorios celulares Cañar";
const contactPhone = "+593 96 364 4323";
const contactEmail = "teamcellmania@gmail.com";
const address = {
  "@type": "PostalAddress",
  "streetAddress": "Luis Cordero Crespo 4-17 y Sucre",
  "addressLocality": "Azogues",
  "addressRegion": "Cañar",
  "postalCode": "030102",
  "addressCountry": "EC"
};
---

<style>
  :root {
    --primary: #1e40af;
    --primary-light: #3b82f6;
    --secondary: #10b981;
    --dark: #1f2937;
    --light: #f9fafb;
  }
  
  .section-padding {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  
  @media (min-width: 768px) {
    .section-padding {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }
  
  .gradient-text {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  
  .card-hover {
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }
  
  .card-hover:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
  }
  
  .btn-hover {
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .btn-hover::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: all 0.6s ease;
  }
  
  .btn-hover:hover::after {
    left: 100%;
  }
  
  .section-title {
    position: relative;
    display: inline-block;
  }
  
  .section-title::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 3px;
    background: var(--primary-light);
  }
  
  .fade-up {
    animation: fadeInUp 0.8s ease forwards;
    opacity: 0;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #contenedor-cotiza {
    transition: all 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateY(-50%) translateX(0);
    box-shadow: -8px 0 40px -8px rgba(79, 70, 229, 0.18), -2px 0 0 0 rgba(79,70,229,0.12);
    border-radius: 20px 0 0 20px;
    overflow: hidden;
  }

  #contenedor-cotiza.es-minimizado {
    transform: translateY(-50%) translateX(calc(100% - 48px));
  }

  @media (max-width: 768px) {
    #contenedor-cotiza.es-minimizado {
      transform: translateY(-50%) translateX(calc(100% - 42px));
    }
  }
</style>

<html lang="es" class="scroll-smooth">
