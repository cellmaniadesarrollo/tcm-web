---
// src/pages/repuestos/[...slug].astro
import { db, Repuestos } from "astro:db";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Body from "../../components/Body.astro";
import RepuestosPricing from "../../components/RepuestosPricing.astro";

// Orden de presentación de familias (del más nuevo al más viejo)
const ORDEN_FAMILIAS = [
  "iphone-17","iphone-16","iphone-15","iphone-14","iphone-13",
  "iphone-12","iphone-11","iphone-xs","iphone-xr","iphone-x",
  "iphone-se","iphone-7","iphone-6","iphone-5","iphone-4",
];

export async function getStaticPaths() {
  const todos = await db.select().from(Repuestos);

  const familias = [...new Set(todos.map((r) => r.familia))];

  const modelosPorFamilia: Record<string, string[]> = {};
  for (const familia of familias) {
    modelosPorFamilia[familia] = [
      ...new Set(
        todos
          .filter((r) => r.familia === familia && !r.modelo.endsWith("-oled"))
          .map((r) => r.modelo)
      ),
    ];
  }

  const paths: { params: { slug: string | undefined } }[] = [];
  paths.push({ params: { slug: undefined } });

  for (const familia of familias) {
    paths.push({ params: { slug: familia } });
    for (const modelo of modelosPorFamilia[familia]) {
      paths.push({ params: { slug: `${familia}/${modelo}` } });
    }
  }

  return paths;
}

// ── Params ───────────────────────────────────────────────
const { slug } = Astro.params;
const partes = slug ? slug.split("/") : [];
const familiaActiva = partes[0] ?? null;
const modeloActivo  = partes[1] ?? null;

// ── Datos ────────────────────────────────────────────────
const todos = await db.select().from(Repuestos);

const familiasBruto = [...new Set(todos.map((r) => r.familia))];
const todasFamilias = [
  ...ORDEN_FAMILIAS.filter((f) => familiasBruto.includes(f)),
  ...familiasBruto.filter((f) => !ORDEN_FAMILIAS.includes(f)),
];

const modelosDeFamilia: string[] = familiaActiva
  ? [
      ...new Set(
        todos
          .filter((r) => r.familia === familiaActiva && !r.modelo.endsWith("-oled"))
          .map((r) => r.modelo)
      ),
    ]
  : [];

const repuestosDelModelo = modeloActivo
  ? todos
      .filter(
        (r) => r.modelo === modeloActivo || r.modelo === `${modeloActivo}-oled`
      )
      .map((r) => ({ ...r, tags: r.tags as string[] | null | undefined }))
  : [];

const imagenDelModelo = repuestosDelModelo[0]?.imageUrl ?? null;

// ── Helpers ──────────────────────────────────────────────
function labelModelo(m: string): string {
  return m.split("-").map((w) =>
    w === "iphone" ? "iPhone" : w === "pro" ? "Pro" : w === "max" ? "Max" :
    w === "mini" ? "mini" : w === "plus" ? "Plus" : w === "oled" ? "OLED" :
    w === "se" ? "SE" : w === "xs" ? "Xs" : w === "xr" ? "Xr" :
    w.charAt(0).toUpperCase() + w.slice(1)
  ).join(" ");
}

// ── SEO meta ─────────────────────────────────────────────
const pageTitle = modeloActivo
  ? `Precio repuestos ${labelModelo(modeloActivo)} | TeamCellMania`
  : familiaActiva
  ? `Repuestos ${labelModelo(familiaActiva)} | TeamCellMania`
  : "Precios de repuestos iPhone | TeamCellMania";

const pageDescription = modeloActivo
  ? `Precio de pantalla y batería para ${labelModelo(modeloActivo)} en TeamCellMania, Azogues y Biblián. Piezas de calidad con garantía. Instalación incluida.`
  : "Consulta los precios de pantallas y baterías para iPhone en TeamCellMania, Azogues y Biblián, Ecuador. Instalación profesional incluida.";

const canonicalUrl = `https://www.teamcellmania.com/repuestos${slug ? `/${slug}` : ""}`;

// ── JSON-LD Schema.org ────────────────────────────────────
// Solo se genera cuando hay un modelo específico seleccionado
const jsonLd = modeloActivo
  ? {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": `Repuestos ${labelModelo(modeloActivo)} - TeamCellMania`,
      "description": pageDescription,
      "url": canonicalUrl,
      "numberOfItems": repuestosDelModelo.length,
      "itemListElement": repuestosDelModelo
        .filter((r) => !r.modelo.endsWith("-oled")) // evitar duplicados
        .flatMap((r, i) => {
          const items = [];
          const nombreBase = r.categoria === "pantalla" ? "Pantalla" : "Batería";
          const nombreModelo = labelModelo(r.modelo);

          if (r.precioSinMensaje != null) {
            items.push({
              "@type": "ListItem",
              "position": i * 2 + 1,
              "item": {
                "@type": "Offer",
                "name": `${nombreBase} ${nombreModelo} sin advertencia`,
                "description": `Cambio de ${nombreBase.toLowerCase()} para ${nombreModelo} con chip incluido. Sin avisos de iOS. Instalación incluida.`,
                "price": r.precioSinMensaje,
                "priceCurrency": "USD",
                "availability": "https://schema.org/InStock",
                "seller": {
                  "@type": "LocalBusiness",
                  "name": "TeamCellMania",
                  "telephone": "+593969010178",
                  "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "Matovelle",
                    "addressLocality": "Azogues",
                    "addressRegion": "Cañar",
                    "addressCountry": "EC",
                  },
                },
              },
            });
          }

          if (r.precioConMensaje != null) {
            items.push({
              "@type": "ListItem",
              "position": i * 2 + 2,
              "item": {
                "@type": "Offer",
                "name": `${nombreBase} ${nombreModelo} con advertencia`,
                "description": `Cambio de ${nombreBase.toLowerCase()} para ${nombreModelo} sin chip. Funciona normal, iOS puede mostrar aviso. Instalación incluida.`,
                "price": r.precioConMensaje,
                "priceCurrency": "USD",
                "availability": "https://schema.org/InStock",
                "seller": {
                  "@type": "LocalBusiness",
                  "name": "TeamCellMania",
                  "telephone": "+593969010178",
                  "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "Matovelle",
                    "addressLocality": "Azogues",
                    "addressRegion": "Cañar",
                    "addressCountry": "EC",
                  },
                },
              },
            });
          }

          return items;
        }),
    }
  : null;

// LocalBusiness schema — aparece en TODAS las páginas /repuestos
const localBusinessLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "TeamCellMania",
  "description": "Reparación profesional de iPhone y celulares. Cambio de pantallas y baterías con garantía en Azogues y Biblián, Ecuador.",
  "url": "https://www.teamcellmania.com",
  "telephone": "+593969010178",
  "image": "https://www.teamcellmania.com/favicon.ico",
  "priceRange": "$$",
  "address": [
    {
      "@type": "PostalAddress",
      "streetAddress": "Matovelle",
      "addressLocality": "Azogues",
      "addressRegion": "Cañar",
      "addressCountry": "EC",
    },
    {
      "@type": "PostalAddress",
      "streetAddress": "Principal",
      "addressLocality": "Azogues",
      "addressRegion": "Cañar",
      "addressCountry": "EC",
    },
    {
      "@type": "PostalAddress",
      "streetAddress": "Bolívar",
      "addressLocality": "Azogues",
      "addressRegion": "Cañar",
      "addressCountry": "EC",
    },
    {
      "@type": "PostalAddress",
      "streetAddress": "Biblián",
      "addressLocality": "Biblián",
      "addressRegion": "Cañar",
      "addressCountry": "EC",
    },
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "09:00",
      "closes": "19:00",
    },
  ],
  "areaServed": ["Azogues", "Biblián", "Cañar"],
  "sameAs": [
    "https://www.facebook.com/teamcellmania",
    "https://www.instagram.com/teamcellmania",
  ],
};
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO básico -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" />

    <!-- Open Graph (WhatsApp / Facebook preview) -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:title"       content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {imagenDelModelo && <meta property="og:image" content={imagenDelModelo} />}
    <meta property="og:locale"      content="es_EC" />

    <!-- JSON-LD: LocalBusiness (todas las páginas) -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessLd)} />

    <!-- JSON-LD: Ofertas del modelo (solo cuando hay modelo activo) -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>

  <Body class="bg-gray-50">
    <Header />
    <main class="pt-[76px]">
      <RepuestosPricing
        familiaActiva={familiaActiva}
        modeloActivo={modeloActivo}
        todasFamilias={todasFamilias}
        modelosDeFamilia={modelosDeFamilia}
        repuestosDelModelo={repuestosDelModelo}
        imagenDelModelo={imagenDelModelo}
      />
    </main>
    <Footer />
  </Body>
</html>