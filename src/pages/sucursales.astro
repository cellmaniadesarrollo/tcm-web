---
// Importaciones (mantenidas igual)
import { Locations } from "../components/Locations";
import Header from "../components/Header.astro";
import Body from "../components/Body.astro";
import BaseHead from "../components/BaseHead.astro";
import CarouselSucursales from "../components/CarouselSucursales";
import { SITE_DESCRIPTION, SITE_TITLE } from "../config";
import Footer from "../components/Footer.astro";
import { GET } from "./locations.json";

let locations = await GET(Astro);
const result = await locations.json()
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <BaseHead title={`Sucursales | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style is:global>
      .animate-fade-in {
        animation: fadeIn 1s ease-out;
      }
      
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      
      .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
      }
      
      .custom-scrollbar::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
      }
      
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e0;
        border-radius: 10px;
      }
      
      .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #a0aec0;
      }

      .skew-section {
        clip-path: polygon(0 0, 100% 3%, 100% 97%, 0% 100%);
      }

      .skew-section-reverse {
        clip-path: polygon(0 3%, 100% 0, 100% 100%, 0% 97%);
      }

      /* Nuevos estilos para el mapa */
      .map-container {
        height: 70vh;
        min-height: 500px;
        margin: 0 auto;
        width: 90%;
        max-width: 1200px;
      }
    </style>
  </head>
  <Body>
    <Header />
    <main class="pt-20">

      <!-- Sección del Mapa Centrado y Grande -->
      <section class="py-16 bg-white">
        <div class="container mx-auto px-6">

          <!-- Listado de ubicaciones debajo del mapa -->
          <div class="max-w-4xl mx-auto mt-16">
            <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100">
              <div class="flex items-center mb-6">
                <div class="relative flex-grow">
                  <input 
                    type="text" 
                    placeholder="Buscar sucursal..." 
                    class="w-full pl-10 pr-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent"
                  >
                  <svg class="absolute left-3 top-3.5 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </div>
              </div>
              
              <div class="space-y-4 max-h-[500px] overflow-y-auto pr-2 custom-scrollbar">
                <Locations locations={result} client:idle />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Carousel de Sucursales Mejorado -->
      <section class="py-24 bg-gradient-to-b from-sky-900 to-blue-800 relative overflow-hidden">
        <div class="container mx-auto px-6 relative z-10">
          <div class="text-center mb-16">
            <span class="text-sm font-semibold tracking-wider text-sky-300 uppercase">Explora</span>
            <h3 class="text-4xl font-bold text-white mt-2">Descubre nuestras sucursales</h3>
            <p class="text-sky-100 text-xl max-w-3xl mx-auto mt-4">Conoce cada uno de nuestros espacios diseñados para brindarte la mejor experiencia</p>
          </div>
          
          <div class="max-w-7xl mx-auto">
            <CarouselSucursales client:load />
          </div>
          
          <div class="text-center mt-16">
            <button class="bg-white text-sky-900 hover:bg-gray-100 px-10 py-4 rounded-full font-semibold transition-all shadow-xl hover:shadow-2xl transform hover:scale-105 inline-flex items-center">
              Ver todas las sucursales
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </div>
        </div>
        <div class="absolute bottom-0 left-0 right-0 h-16 bg-white skew-section-reverse"></div>
      </section>

      <!-- CTA Section Mejorada -->
      <section class="py-28 bg-gray-50">
        <div class="container mx-auto px-6 max-w-5xl">
          <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
            <div class="md:flex">
              <div class="md:w-1/2 bg-gradient-to-br from-blue-700 to-sky-600 p-12 text-white flex flex-col justify-center">
                <h2 class="text-3xl font-bold mb-4">¿Listo para visitarnos?</h2>
                <p class="text-lg opacity-90 mb-6">Encuentra la sucursal perfecta para tus necesidades y disfruta de la mejor experiencia.</p>
                <div class="flex items-center">
                  <svg class="h-8 w-8 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <span class="text-xl font-medium">Más de 50 sucursales en todo el país</span>
                </div>
              </div>
              <div class="md:w-1/2 p-12">
                <h3 class="text-2xl font-bold text-gray-800 mb-6">¿No encuentras lo que buscas?</h3>
                <p class="text-gray-600 mb-8">Contáctanos y te ayudaremos a encontrar la sucursal perfecta para tus necesidades.</p>
                <div class="space-y-4">
                  <button class="w-full bg-sky-600 hover:bg-sky-700 text-white px-6 py-4 rounded-lg font-medium transition-colors flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                    Llamar ahora
                  </button>
                  <button class="w-full bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 px-6 py-4 rounded-lg font-medium transition-colors flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    Enviar mensaje
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </Body>
</html>